*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
/env/
.env
.env.*
!.env.example

# ---- PyInstaller 打包产物 ----
build/
dist/

# ---- Release 附件（zip 产物）----
releases/*.zip

# ---- 运行/转换输出 ----
converted/
extracted/

# ---- 第三方参考源码（研究用，仅本地保留）----
research/
gimp-utils.c
gimpbrush-load-2014.c

# ---- 测试样本（商用笔刷素材，体积大，请自备）----
# 用 ** 递归匹配，样本放进 tests/samples/ 之类的子目录时也不会被误提交
tests/**/*.abr
# ---- 任务 110：本项目自己生成的 1 支测试笔刷必须入库（可复现）----
# 例外原因：上面那条规则会连同生成物一起忽略。tests/abr-generated/ 里的 .abr
# 由 tools/make_test_abr.py 现场合成（非商用素材、只有 1 支、约 5 KB），
# 任务 111 批量生成与使用者人工验收都要靠它复现，故单独放行。
!tests/abr-generated/*.abr

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- WorkBuddy 项目数据 ----
.workbuddy/

# ---- Mnemon 运行时记忆（本地，勿提交）----
.mnemon/

# ---- 测试生成产物 ----
tests/**/*.kpp

# ---- 代码审查工具输出 ----
result.json

# ---- OS ----
.DS_Store
Thumbs.db

